{
  "name": "coding-agent-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "A local desktop workbench for advanced developers, driving software requirements from clarification through implementation and review.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "node scripts/test-m1.mjs && node tests/integration/interrupt-transaction.mjs && node scripts/test-agent-manager.mjs",
    "test:agent-manager": "node scripts/test-agent-manager.mjs",
    "build": "tsc --build && electron-vite build",
    "dev": "electron-vite dev",
    "typecheck": "tsc --build",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1"
  },
  "devDependencies": {
    "@openai/codex": "0.153.2",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.153.2-win32-x64",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
