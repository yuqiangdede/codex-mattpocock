# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
dist-build/
dist-release/
undefined/
out/
*.tsbuildinfo

# M1 E2E runtime data (regenerated by .scratch/m1-e2e/verify.mjs)
.scratch/m1-e2e/workbench.db*
.scratch/m1-e2e/worktrees/
# M1 fixture is a nested git repo (drives worktree demo); not tracked here
.scratch/m1-fixture/

# Runtime
runtime/*
!runtime/.gitkeep

# Data
data/*
!data/.gitkeep

# Cache
cache/*
!cache/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Release evidence (keep manifests and key traces, exclude large schema dirs)
release-evidence/*
!release-evidence/.gitkeep
!release-evidence/runtime-manifest.json
!release-evidence/schema-hash.txt
!release-evidence/protocol-trace/
!release-evidence/protocol-trace/initialize-trace.jsonl
!release-evidence/protocol-trace/thread-lifecycle-trace.jsonl
!release-evidence/protocol-trace/turn-control-trace.jsonl
!release-evidence/protocol-trace/approval-mechanism-trace.jsonl
!release-evidence/protocol-trace/reviewer-subagent-trace.jsonl
!release-evidence/protocol-trace/api-boundary.md
!release-evidence/failure-injection/
!release-evidence/failure-injection/disconnect-no-replay-trace.jsonl
!release-evidence/provider-probe-report.json
!release-evidence/sqlite-packaged-test.json
!release-evidence/secret-isolation-report.json
!release-evidence/build-manifest.json
!release-evidence/m1-slice-e2e.json
!release-evidence/go-no-go-decision.md
# Schema dirs are too large for git, tracked via hash only
release-evidence/protocol-trace/typescript-types/
release-evidence/protocol-trace/json-schema/
release-evidence/schema/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Temp files
_tmp_*
electron.vite.config.*.mjs
